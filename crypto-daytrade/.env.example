# Bot do Telegram — crie via @BotFather no Telegram (separado do bot de apostas esportivas)
TELEGRAM_BOT_TOKEN=

# Chat/grupo para onde os alertas serão enviados. Grupo tem chat_id NEGATIVO
# (ex: -1001234567890) — mande uma mensagem no grupo e acesse
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates pra descobrir.
TELEGRAM_CHAT_ID=

# --- Opcional — sobrescreve os padrões definidos em config.py ---
# Quantos pares (por volume 24h em USDT) escanear a cada execução
# TOP_SYMBOLS_COUNT=25
# Intervalo dos candles usados nos indicadores (day trade)
# TIMEFRAME=15m
# Sinal aberto que não bate alvo nem stop dentro desse prazo vira "expirado"
# SIGNAL_EXPIRY_HOURS=24
# STORAGE_PATH=storage/signals.json
