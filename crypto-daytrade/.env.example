# Bot do Telegram — crie via @BotFather no Telegram (separado do bot de apostas esportivas)
TELEGRAM_BOT_TOKEN=

# Chat/grupo para onde os alertas serão enviados. Grupo tem chat_id NEGATIVO
# (ex: -1001234567890) — mande uma mensagem no grupo e acesse
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates pra descobrir.
TELEGRAM_CHAT_ID=

# --- Opcional — sobrescreve os padrões definidos em config.py ---
# Quantos pares (por volume 24h em USDT) escanear a cada execução
# TOP_SYMBOLS_COUNT=25
# Intervalo dos candles usados nos indicadores (day trade)
# TIMEFRAME=15m
# Mercado em que os alertas serão usados: spot aceita apenas longs; futures aceita long e short.
# TRADING_MODE=futures
# Máximo de sinais em aberto; pares cripto costumam ser correlacionados.
# MAX_OPEN_POSITIONS=3
# MAX_OPEN_PER_DIRECTION=2
# Sinal aberto que não bate alvo nem stop dentro desse prazo vira "expirado"
# SIGNAL_EXPIRY_HOURS=24
# Hipóteses do backtest, por lado (ex.: 0.0004 = 0,04%). Ajuste para sua conta.
# BACKTEST_TAKER_FEE_RATE=0.0004
# BACKTEST_SLIPPAGE_RATE=0.0002
# BACKTEST_FUNDING_RATE_PER_8H=0.0
# Universo fixo para backtests; evite usar automaticamente o top volume de hoje no passado.
# BACKTEST_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,LINKUSDT
# STORAGE_PATH=storage/signals.json
