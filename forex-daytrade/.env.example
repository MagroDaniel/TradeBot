# Chave da Twelve Data (https://twelvedata.com) — free tier, cria em segundos
TWELVEDATA_API_KEY=

# Mesmo bot/grupo do Telegram do crypto-daytrade (decisão do usuário, 2026-09-09) — não são
# credenciais novas, reaproveita as mesmas do bot de cripto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcional — sobrescreve os padrões definidos em config.py ---
# Pares a escanear, separados por vírgula. Começa só com EUR/USD (decisão do usuário,
# 2026-09-09) pra caber folgado na cota de 800 chamadas/dia do free tier da Twelve Data.
# FOREX_SYMBOLS=EUR/USD
# Intervalos dos candles (formato Twelve Data: 1min, 5min, 15min, 1h, 4h, 1day...)
# TIMEFRAME=15min
# HIGHER_TIMEFRAME=1h
# Filtros ainda NÃO validados via backtest pra forex — deixe desligados até rodar
# backtest/run.py contra histórico real (ver analysis/signals.py e docs/).
# USE_HIGHER_TIMEFRAME_FILTER=false
# MIN_RANGE_EXPANSION=
# MAX_OPEN_POSITIONS=1
# MAX_OPEN_PER_DIRECTION=1
# Sinal aberto que não bate alvo nem stop dentro desse prazo vira "expirado"
# SIGNAL_EXPIRY_HOURS=24
# STORAGE_PATH=storage/signals.json
# Arquivo separado, usado só por news_watch.py (estratégia experimental de notícia — ver
# analysis/news_signals.py). Nunca mistura com STORAGE_PATH acima.
# NEWS_STORAGE_PATH=storage/news_signals.json
