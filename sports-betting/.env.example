# The Odds API — https://the-odds-api.com/ (free tier: 500 créditos/mês)
ODDS_API_KEY=

# Bot do Telegram — crie via @BotFather no Telegram e copie o token
TELEGRAM_BOT_TOKEN=

# Chat para onde os alertas serão enviados (seu chat pessoal ou de um grupo).
# Dica: mande uma mensagem para o bot e acesse
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates para descobrir o chat_id
TELEGRAM_CHAT_ID=

# --- Opcional — sobrescreve os padrões definidos em config.py ---
# Chaves de liga da The Odds API, separadas por vírgula
# SPORT_KEYS=soccer_brazil_campeonato,soccer_epl
# REGIONS=eu
# MARKETS=h2h,totals
# EV_THRESHOLD=0.05
# KELLY_FRACTION=0.25
# MAX_STAKE_FRACTION=0.03
# HISTORICAL_DATA_PATH=data/historical/brasileirao.csv
# Meia-vida (dias) da ponderação temporal do modelo — jogos com essa idade pesam metade
# de um jogo de hoje. "none" desativa (média simples sobre todo o histórico).
# MODEL_HALF_LIFE_DAYS=1095
