# The Odds API — https://the-odds-api.com/ (free tier: 500 créditos/mês)
ODDS_API_KEY=

# Bot do Telegram — crie via @BotFather no Telegram e copie o token
TELEGRAM_BOT_TOKEN=

# Chat para onde os alertas serão enviados (seu chat pessoal ou de um grupo).
# Dica: mande uma mensagem para o bot e acesse
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates para descobrir o chat_id
TELEGRAM_CHAT_ID=

# Opcional — habilita a checagem de notícias (lesões, suspensões) via Claude com busca na
# web pros jogos que geraram pick (ver data/news_check.py). Sem essa chave, o bot funciona
# normal, só sem esse aviso. Pegue a sua em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Opcional — sobrescreve os padrões definidos em config.py ---
# Chaves extras da The Odds API, separadas por vírgula — usadas em sequência quando a
# anterior fica sem crédito/limite (soma o free tier de mais de uma conta).
# ODDS_API_KEYS_EXTRA=outra-chave,mais-uma-chave

# Chaves de competição da The Odds API, separadas por vírgula. Cada uma precisa de um CSV
# histórico em HISTORICAL_DATA_DIR/{sport_key}.csv (ver README).
# SPORT_KEYS=soccer_brazil_campeonato,soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_uefa_europa_conference_league
# REGIONS=eu
# MARKETS=h2h,totals
# Mercados adicionais (ambas marcam, dupla chance) — cobrados por evento, só buscados pros
# jogos de hoje já filtrados. "none" desativa.
# ADDITIONAL_MARKETS=btts,double_chance
# EV_THRESHOLD=0.05
# KELLY_FRACTION=0.25
# MAX_STAKE_FRACTION=0.03
# Nº de pernas do bilhete de múltipla sugerido — as N seleções de maior probabilidade do dia
# (uma por jogo), não as de maior EV. Puramente informativo (ver analysis/multiple.py). "0"
# desativa o recurso.
# MULTIPLE_LEGS=4
# Diretório com um CSV histórico por competição, nomeado {sport_key}.csv
# HISTORICAL_DATA_DIR=data/historical
# Meia-vida (dias) da ponderação temporal do modelo — jogos com essa idade pesam metade
# de um jogo de hoje. "none" desativa (média simples sobre todo o histórico).
# MODEL_HALF_LIFE_DAYS=1095
